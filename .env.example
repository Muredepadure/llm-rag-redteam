# Which backend runs the agent: ollama | anthropic
PROVIDER=ollama

# Ollama Cloud key (ollama.com/settings/keys). Leave empty to use a local Ollama server.
OLLAMA_API_KEY=

# Claude API key, only needed when PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Model under test. Empty = provider default (gpt-oss:120b / claude-opus-5-5).
# Ollama Cloud list: curl https://ollama.com/api/tags
AGENT_MODEL=
# Claude only: low | medium | high | xhigh | max
AGENT_EFFORT=medium
